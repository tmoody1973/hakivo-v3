# Hakivo v3 — environment template
#
# Copy this file to `.env.local` (it's gitignored) or let each CLI write its
# own values. Many of these are auto-populated by CLI bootstrappers:
#
#   bunx convex dev                 → writes CONVEX_DEPLOYMENT + CONVEX_URL
#   bunx trigger.dev@latest init    → writes TRIGGER_* keys
#   bunx vercel link                → wires Vercel project
#   bunx wrangler login             → auths Cloudflare R2
#
# Fill the rest by hand once accounts exist.

# ─── Convex (auto-written by `convex dev`) ─────────────────────────────
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ─── Clerk (dashboard only — paste after creating the app) ────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Set on Convex dashboard env too, not locally — used by convex/auth.config.ts
CLERK_JWT_ISSUER_DOMAIN=

# ─── Trigger.dev (auto-written by `trigger.dev init`) ─────────────────
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# ─── Vercel AI Gateway (enable in Vercel dashboard) ───────────────────
AI_GATEWAY_API_KEY=

# ─── Direct model providers (used as AI Gateway fallbacks only) ───────
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Congress.gov (reuse v2 key or request a new one) ─────────────────
CONGRESS_API_KEY=

# ─── Cloudflare R2 (for audio storage) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hakivo-audio
R2_PUBLIC_BASE_URL=

# ─── Google Classroom (OAuth) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Hybiscus (PDF generation) ────────────────────────────────────────
HYBISCUS_API_KEY=

# ─── Resend (transactional email) ─────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=packets@hakivo.com

# ─── Stripe (reuse v2 live keys) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEACHER_YEARLY_PRICE_ID=
STRIPE_TEACHER_MONTHLY_PRICE_ID=
STRIPE_CONSUMER_MONTHLY_PRICE_ID=

# ─── PostHog ──────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Sanity CMS (blog) ────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
